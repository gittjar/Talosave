# Deployment settings for Azure App Service
# This file tells Azure to build the application on the server
# instead of deploying node_modules from local machine

# Enable build during deployment
SCM_DO_BUILD_DURING_DEPLOYMENT=true

# Use npm install (not npm ci) during deployment
NPM_USE_PRODUCTION=false

# Set Node.js version (matches package.json engines)
WEBSITE_NODE_DEFAULT_VERSION=~22

# Enable detailed logging
SCM_TRACE_LEVEL=4
